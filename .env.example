# The Refinery - environment template.
#
# Copy this file to .env and fill in your own values.
# Never commit .env. The .gitignore already excludes it.

# ── Anthropic ──────────────────────────────────────────────────────────────
# Get one at https://console.anthropic.com/. The key looks like sk-ant-...
ANTHROPIC_API_KEY=

# ── Email delivery (Gmail SMTP) ────────────────────────────────────────────
# 1. Create a dedicated Gmail address you don't use for anything else.
# 2. Turn on 2-Step Verification on that account.
# 3. Generate an App Password at https://myaccount.google.com/apppasswords.
# 4. Use the App Password below, NOT your main Gmail password.
SMTP_USER=
SMTP_PASSWORD=

# Where the Refinery sends reports and alerts. This is usually your
# personal email, separate from SMTP_USER.
TO_EMAIL=

# ── Optional ───────────────────────────────────────────────────────────────
# Set to true to get verbose logs in scheduler / run_*.py. Default false.
DEBUG=false

# Override the UI bind host. Default is 127.0.0.1 (localhost only).
# Set to 0.0.0.0 to expose the dashboard on your local network. Anyone on
# the same Wi-Fi who can reach the port can then read your portfolio.
# REFINERY_UI_HOST=127.0.0.1

# Override the UI port. Default is 5173.
# REFINERY_UI_PORT=5173
